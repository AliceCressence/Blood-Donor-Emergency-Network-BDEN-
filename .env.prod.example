# BDEN production environment template
# Copy this to /var/www/bden/.env.prod on the VPS and replace every change-me value.

DEBUG=False
SECURE_SSL_REDIRECT=True
BDEN_GATEWAY_HOST_PORT=8080
BDEN_FRONTEND_HOST_PORT=8088
GUNICORN_WORKERS=3

# Include service hostnames for Docker networking, the public domain, and raw IP while DNS/OAuth are being tested.
ALLOWED_HOSTS=bden.hinkaku.tech,3.77.183.190,localhost,127.0.0.1,auth-service,donor-service,request-service,campaign-service,notification-service
FRONTEND_URL=https://bden.hinkaku.tech
VITE_API_BASE_URL=https://bden.hinkaku.tech

AUTH_SECRET_KEY=change-me-generate-a-long-random-value
DONOR_SECRET_KEY=change-me-generate-a-long-random-value
REQUEST_SECRET_KEY=change-me-generate-a-long-random-value
CAMPAIGN_SECRET_KEY=change-me-generate-a-long-random-value
NOTIFICATION_SECRET_KEY=change-me-generate-a-long-random-value
INTERNAL_API_KEY=change-me-generate-a-long-random-value

AUTH_DB_NAME=bden_auth
AUTH_DB_USER=bden_auth_user
AUTH_DB_PASSWORD=change-me-auth-db-password
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432

DONOR_DB_NAME=bden_donor
DONOR_DB_USER=bden_donor_user
DONOR_DB_PASSWORD=change-me-donor-db-password
DONOR_DB_HOST=donor-db
DONOR_DB_PORT=5432

REQUEST_DB_NAME=bden_request
REQUEST_DB_USER=bden_request_user
REQUEST_DB_PASSWORD=change-me-request-db-password
REQUEST_DB_HOST=request-db
REQUEST_DB_PORT=5432

CAMPAIGN_DB_NAME=bden_campaign
CAMPAIGN_DB_USER=bden_campaign_user
CAMPAIGN_DB_PASSWORD=change-me-campaign-db-password
CAMPAIGN_DB_HOST=campaign-db
CAMPAIGN_DB_PORT=5432

NOTIFICATION_DB_NAME=bden_notification
NOTIFICATION_DB_USER=bden_notification_user
NOTIFICATION_DB_PASSWORD=change-me-notification-db-password
NOTIFICATION_DB_HOST=notification-db
NOTIFICATION_DB_PORT=5432

REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
DEFAULT_MATCHING_RADIUS_KM=30
MAX_MATCHING_RADIUS_KM=100

ACCESS_TOKEN_LIFETIME_MINUTES=480
REFRESH_TOKEN_LIFETIME_DAYS=30
JWT_ALGORITHM=HS256

AUTH_SERVICE_INTERNAL_URL=http://auth-service:8001
DONOR_SERVICE_INTERNAL_URL=http://donor-service:8002
DONOR_SERVICE_URL=http://donor-service:8002
REQUEST_SERVICE_INTERNAL_URL=http://request-service:8003
CAMPAIGN_SERVICE_INTERNAL_URL=http://campaign-service:8004
NOTIFICATION_SERVICE_INTERNAL_URL=http://notification-service:8005
NOTIFICATION_SERVICE_URL=http://notification-service:8005

# Google OAuth production callback.
# Add both of these redirect URIs to Google while the raw IP and domain are both in use:
# https://bden.hinkaku.tech/auth/google/callback
# http://3.77.183.190/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bden.hinkaku.tech/auth/google/callback
GOOGLE_AUTH_FRONTEND_CALLBACK_URL=https://bden.hinkaku.tech/auth/google/callback

GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
